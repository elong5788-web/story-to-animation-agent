# 复制这个文件,改名为 config.properties,然后填上你的密钥。
# config.properties 已在 .gitignore 里,不会被上传到 git。

DEEPSEEK_API_KEY=在这里填你的DeepSeek密钥
ARK_API_KEY=在这里填你的火山引擎Ark密钥

# 以下是可选参数(不填就用默认值):

# 生成的预览视频时长(秒),默认 5。值越大越慢、越贵,且要模型支持。
DURATION=5

# 文生图分辨率,默认 2K。
IMAGE_SIZE=2K

# 视频分辨率,默认 720p。
RESOLUTION=720p

# RAG 语义检索(可选):实测在 761 片段规模下,多模态 embedding(纯文本输入)让召回变差
# (precision@3 0.60→0.47),故默认关。语料规模变大或换专用文本 embedding 模型后再开。
RAG_EMBEDDING=false

# embedding 模型(按你 Ark 账号实际开通的填)。
EMBEDDING_MODEL=doubao-embedding-vision-251215

# RAG 重排(可选):true 时召回后用 DeepSeek 精排,多花一次调用但 top-k 更准。
RAG_RERANK=false

# 读小说出片:true = 用参考图模型锁定角色(需 Ark 开通 doubao-seedance-1-0-lite-i2v-250428);
# false = 只靠关键帧角色卡锁定(现有 Seedance 2.0 即可)。
USE_REFERENCE_IMAGE=false
